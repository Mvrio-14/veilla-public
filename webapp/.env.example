# Frontend configuration. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* variables are inlined into the JavaScript bundle at build
# time and are therefore public. Never put a secret behind that prefix.
# On Vercel, set the same keys in Project Settings -> Environment Variables.

# The backend. Point it at the Render service in production, or at a local
# `uvicorn src.api:app --reload` while developing.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase, from Project Settings -> API. The publishable key is designed
# to ship to the browser; row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only, used by the contact form. No NEXT_PUBLIC_ prefix, so it
# stays out of the bundle. Unset, the form returns an error on submit.
# RESEND_API_KEY=re_...

# Error monitoring. Unset, Sentry is a no-op.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
