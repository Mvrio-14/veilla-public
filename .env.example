# Backend configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way. In production nothing reads
# this file — Render holds the same keys in the `veilla-news-backend` env
# group declared in render.yaml.
#
# The frontend has its own file: webapp/.env.local. See webapp/README.md.

# ── Required ────────────────────────────────────────────────────────────

# Supabase connection strings, from Project Settings -> Database.
# DATABASE_URL is the pooler (port 6543) and backs ordinary requests.
# DATABASE_URL_DIRECT is the direct connection (port 5432) and is needed by
# anything holding a session-scoped advisory lock — the ingest pass does.
# Unset, it falls back to DATABASE_URL, which works but silently weakens
# the lock that stops two passes overlapping. Set it in production.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Your Supabase project URL. The API derives the JWKS endpoint from it to
# validate the ES256 tokens the browser sends.
SUPABASE_URL=https://xxxx.supabase.co

OPENAI_API_KEY=sk-...

# Server-side Supabase key (Project Settings -> API keys), used to broadcast
# Realtime events — the "new articles" pill and the "updated at" heartbeat.
# Unset, those broadcasts are skipped and everything else works.
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated. These addresses, and only these, reach /admin.
ADMIN_EMAILS=you@example.com

# ── Required in production, optional locally ────────────────────────────

# Which browser origins may call this API. The default is
# "https://veilla.io,https://www.veilla.io,http://localhost:3000", so local
# development needs nothing. A deployment on any other domain must set it,
# or every request from the browser fails CORS.
# CORS_ALLOWED_ORIGINS=https://news.veilla.io

# Where the links in notification emails point. Defaults to
# https://veilla.io — which is wrong for any other deployment, and wrong in
# a way nobody notices until a recipient clicks a link and lands on the
# wrong site. Set it to the frontend's real address.
# WEBAPP_URL=https://news.veilla.io

# Transactional email. Without RESEND_API_KEY, in-app notifications still
# work and nothing is emailed.
# RESEND_API_KEY=re_...
# NOTIF_FROM=Veilla <hello@veilla.io>

# ── Optional ────────────────────────────────────────────────────────────

# Error monitoring. Unset, Sentry is a no-op.
# SENTRY_DSN=https://...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# The identity the MCP tools act as. Required to use them at all — unset,
# each tool raises an error naming the missing variable rather than
# guessing whose data to return. It must name a user that exists.
# VEILLA_MCP_USER_SLUG=demo-user

# Bearer token for remote MCP clients calling /mcp/. Unset, the endpoint
# answers 503: it is never open.
# MCP_SHARED_TOKEN=

# Statement timeout in milliseconds, applied per connection.
# DB_STATEMENT_TIMEOUT=30000

# ── Bootstrap switches — leave unset ────────────────────────────────────
#
# `sync_catalog_to_db` seeds catalogue entries and sources from
# config/catalog.json, and runs only when the `catalog` table is empty. On a populated database it
# skips by itself, so neither of these is needed in normal operation.
#
#   SKIP_CATALOG_SYNC=1   never run it
#   FORCE_CATALOG_SYNC=1  run it even on a populated database
#
# FORCE is destructive: it overwrites live entries, edited through /admin,
# with whatever the JSON snapshot last held. Do not set it in a deployment.
